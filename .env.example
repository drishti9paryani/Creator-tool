# ─────────────────────────────────────────────────────────────────────────────
# PROTOTYPE — environment template
#
# HOW TO USE:
#   1. Copy this file to ".env.local"   (that file is git-ignored; keys stay off git)
#   2. Paste your FRESH keys into .env.local
#   3. Restart the dev server (npm run dev)
#
# NEVER put real keys in this .env.example file — it IS committed to git.
# ─────────────────────────────────────────────────────────────────────────────

# Which backend to use: "real" = live AI, "mock" = canned data (no keys needed)
AI_PROVIDER=real

# ── Text generation: opencode Zen, routed to a Gemini model ──────────────────
OPENCODE_API_KEY=
# Defaults are fine; override only if you want a different model / endpoint.
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=gemini-3.5-flash-lite

# ── Image generation: OpenAI ─────────────────────────────────────────────────
OPENAI_API_KEY=
# Cheapest modern option is gpt-image-1 at low quality.
# For absolute lowest cost, set OPENAI_IMAGE_MODEL=dall-e-2 (lower quality).
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=low
IMAGE_LIMIT_PER_PROJECT=150
